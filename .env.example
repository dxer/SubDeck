# JWT signing secret (recommended for production; if omitted, a random secret is generated and persisted in SQLite)
SUBDECK_JWT_SECRET=change-this-to-a-very-secure-random-string-in-production

# Comma-separated trusted reverse proxy IPs/CIDRs (leave empty if exposed directly)
# SUBDECK_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Allowed CORS origin for local frontend development or restricted web origin
# SUBDECK_CORS_ORIGIN=http://localhost:5173
